#!/bin/sh
set -e

if command -v python3 >/dev/null 2>&1; then
  python3 scripts/collate_characters.py
elif command -v python >/dev/null 2>&1; then
  python scripts/collate_characters.py
elif command -v py >/dev/null 2>&1; then
  py -3 scripts/collate_characters.py
else
  echo "Python is required to run scripts/collate_characters.py" >&2
  exit 1
fi

# Stage generated files so the commit includes updated character summaries.
git add Character/*.md 2>/dev/null || true